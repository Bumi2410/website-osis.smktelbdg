rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Dokumen penanda admin hanya boleh dibaca oleh pemilik UID-nya.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Form Kritik & Saran dari website publik.
    match /kritik_saran/{pesanId} {
      allow create: if
        request.resource.data.keys().hasOnly(['nama', 'kelas', 'pesan', 'createdAt'])
        && request.resource.data.nama is string
        && request.resource.data.nama.size() >= 2
        && request.resource.data.nama.size() <= 60
        && request.resource.data.kelas is string
        && request.resource.data.kelas.size() >= 1
        && request.resource.data.kelas.size() <= 30
        && request.resource.data.pesan is string
        && request.resource.data.pesan.size() >= 5
        && request.resource.data.pesan.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Konten yang dikelola admin. Pembacaan publik agar bisa ditampilkan di website.
    match /news/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /activities/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Opsional: koleksi inbox untuk formulir pesan terpisah.
    match /inbox/{messageId} {
      allow create: if
        request.resource.data.keys().hasOnly(['nama', 'email', 'pesan', 'createdAt'])
        && request.resource.data.nama is string
        && request.resource.data.nama.size() >= 2
        && request.resource.data.nama.size() <= 60
        && request.resource.data.pesan is string
        && request.resource.data.pesan.size() >= 2
        && request.resource.data.pesan.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
